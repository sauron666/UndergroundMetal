# ---------- Core ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Underground Metal"

# ---------- Database (Postgres) ----------
# Use Supabase, Neon, Railway, or local Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/undergroundmetal?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/undergroundmetal?schema=public"

# ---------- Auth (NextAuth v5) ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# OAuth providers (optional, configure those you want)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- AI ----------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_DISCOVERY="claude-opus-4-7"
ANTHROPIC_MODEL_MODERATION="claude-haiku-4-5-20251001"

# ---------- External data sources ----------
# MusicBrainz requires only a User-Agent string (no API key)
MUSICBRAINZ_USER_AGENT="UndergroundMetal/0.1 (contact@undergroundmetal.app)"

# Last.fm (optional, for tags + similar artists)
LASTFM_API_KEY=""

# Spotify (optional, for cover art + previews)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Bandsintown (concerts) - public app id
BANDSINTOWN_APP_ID="undergroundmetal"

# Songkick (concerts)
SONGKICK_API_KEY=""

# ---------- Affiliate / ticketing ----------
# These are outbound URLs only; no checkout happens on our side.
TICKETPRO_AFFILIATE_TAG=""
EVENTIM_AFFILIATE_TAG=""
SEETICKETS_AFFILIATE_TAG=""

# ---------- Monetization ----------
# Stripe for premium tier
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_YEARLY=""

# ---------- Analytics (optional) ----------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ---------- Feature flags ----------
ENABLE_SCRAPERS="false"
ENABLE_AI_MODERATION="true"

# ---------- Web Push (concert alerts) ----------
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@undergroundmetal.app"
# Mirror the public key for the browser bundle
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ---------- Object storage (Cloudflare R2 recommended; AWS S3 / Backblaze also work) ----------
# R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="undergroundmetal-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public read URL prefix. For R2: https://<bucket>.<account>.r2.dev or custom domain
NEXT_PUBLIC_S3_PUBLIC_URL=""

# ---------- Email (Resend) ----------
RESEND_API_KEY=""
EMAIL_FROM="Underground Metal <noreply@undergroundmetal.app>"
EMAIL_REPLY_TO="contact@undergroundmetal.app"
